"\n    with first_search as (\n        select customer_id, min(day) as exposed_day from searches where day >= 0 group by customer_id),\n    test_orders as (\n        select customer_id, count(*) as orders from orders where day >= 0 group by customer_id)\n    select a.customer_id, a.variant,\n           f.exposed_day is not null as triggered,\n           coalesce(o.orders, 0) as orders\n    from assignments a\n    left join first_search f using (customer_id)\n    left join test_orders o using (customer_id)\n    "
